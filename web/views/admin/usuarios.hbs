{{!-- Panel admin: lista de todos los usuarios del sistema (solo accesible con rol admin). --}}

<div class="container-fluid mt-5 mb-5">
    <div class="row">
        <div class="col-12">
            <h1 class="fw-bold mb-4">
                <i class="fa-solid fa-users me-2 text-primary"></i>Gestión de Usuarios
            </h1>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div id="admin-usuarios-root"></div>
        </div>
    </div>
</div>

<style>
    .admin-usuarios {
        padding: 1rem;
    }

    .search-filters {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .search-box {
        flex: 1;
        min-width: 250px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
    }

    .search-box input {
        flex: 1;
        border: none;
        background: transparent;
        outline: none;
        font-size: 0.95rem;
    }

    .sort-select {
        min-width: 200px;
    }

    .sort-select select {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        background: white;
        cursor: pointer;
    }

    .info-count {
        padding: 0.75rem 0;
        margin-bottom: 1rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .table-responsive {
        margin-bottom: 0;
    }

    .table {
        margin-bottom: 0;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .mono {
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        color: #6c757d;
    }

    .email {
        font-size: 0.9rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .empty-state p {
        margin: 1rem 0 0 0;
    }
</style>

<script>
    // Componente React para listar usuarios
    const { useState, useMemo } = React;

    function AdminUsuarios({ usuarios: usuariosInicial = [] }) {
        const [busqueda, setBusqueda] = useState('');
        const [ordenar, setOrdenar] = useState('nombre');

        // Filtrar por búsqueda
        const usuariosFiltrados = useMemo(() => {
            return usuariosInicial.filter(u =>
                (u.NOMBRE && u.NOMBRE.toLowerCase().includes(busqueda.toLowerCase())) ||
                (u.APELLIDOS && u.APELLIDOS.toLowerCase().includes(busqueda.toLowerCase())) ||
                (u.EMAIL && u.EMAIL.toLowerCase().includes(busqueda.toLowerCase())) ||
                (u.ID && u.ID.toString().includes(busqueda))
            );
        }, [busqueda, usuariosInicial]);

        // Ordenar
        const usuariosOrdenados = useMemo(() => {
            const copia = [...usuariosFiltrados];
            if (ordenar === 'nombre') {
                copia.sort((a, b) => (a.NOMBRE || '').localeCompare(b.NOMBRE || ''));
            } else if (ordenar === 'email') {
                copia.sort((a, b) => (a.EMAIL || '').localeCompare(b.EMAIL || ''));
            } else if (ordenar === 'compras') {
                copia.sort((a, b) => (b.CONTADORCOMPRAS || 0) - (a.CONTADORCOMPRAS || 0));
            } else if (ordenar === 'ventas') {
                copia.sort((a, b) => (b.CONTADORVENTAS || 0) - (a.CONTADORVENTAS || 0));
            }
            return copia;
        }, [usuariosFiltrados, ordenar]);

        return React.createElement('div', { className: 'admin-usuarios' },
            React.createElement('div', { className: 'search-filters' },
                React.createElement('div', { className: 'search-box' },
                    React.createElement('i', { className: 'fa-solid fa-search' }),
                    React.createElement('input', {
                        type: 'text',
                        placeholder: 'Buscar por nombre, email o ID...',
                        value: busqueda,
                        onChange: (e) => setBusqueda(e.target.value)
                    })
                ),
                React.createElement('div', { className: 'sort-select' },
                    React.createElement('select', {
                        value: ordenar,
                        onChange: (e) => setOrdenar(e.target.value)
                    },
                        React.createElement('option', { value: 'nombre' }, 'Ordenar por: Nombre'),
                        React.createElement('option', { value: 'email' }, 'Ordenar por: Email'),
                        React.createElement('option', { value: 'compras' }, 'Ordenar por: Compras (mayor)'),
                        React.createElement('option', { value: 'ventas' }, 'Ordenar por: Ventas (mayor)')
                    )
                )
            ),
            React.createElement('div', { className: 'info-count' },
                React.createElement('span', null, usuariosOrdenados.length + ' usuarios encontrados')
            ),
            usuariosOrdenados.length > 0 ? React.createElement('div', { className: 'table-responsive' },
                React.createElement('table', { className: 'table table-hover' },
                    React.createElement('thead', { className: 'table-light' },
                        React.createElement('tr', null,
                            React.createElement('th', null, 'ID'),
                            React.createElement('th', null, 'Nombre'),
                            React.createElement('th', null, 'Apellidos'),
                            React.createElement('th', null, 'Email'),
                            React.createElement('th', { className: 'text-center' }, 'Compras'),
                            React.createElement('th', { className: 'text-center' }, 'Ventas'),
                            React.createElement('th', { className: 'text-center' }, 'Rol')
                        )
                    ),
                    React.createElement('tbody', null,
                        usuariosOrdenados.map((usuario) =>
                            React.createElement('tr', { key: usuario.ID },
                                React.createElement('td', { className: 'mono' }, usuario.ID),
                                React.createElement('td', null, usuario.NOMBRE),
                                React.createElement('td', null, usuario.APELLIDOS),
                                React.createElement('td', { className: 'email' }, usuario.EMAIL),
                                React.createElement('td', { className: 'text-center' },
                                    React.createElement('span', { className: 'badge bg-info' }, usuario.CONTADORCOMPRAS || 0)
                                ),
                                React.createElement('td', { className: 'text-center' },
                                    React.createElement('span', { className: 'badge bg-success' }, usuario.CONTADORVENTAS || 0)
                                ),
                                React.createElement('td', { className: 'text-center' },
                                    usuario.ESADMIN ?
                                        React.createElement('span', { className: 'badge bg-danger' }, 'Admin') :
                                        React.createElement('span', { className: 'badge bg-secondary' }, 'Usuario')
                                )
                            )
                        )
                    )
                )
            ) : React.createElement('div', { className: 'empty-state' },
                React.createElement('i', { className: 'fa-solid fa-inbox' }),
                React.createElement('p', null, 'No hay usuarios que coincidan con la búsqueda')
            )
        );
    }

    // Datos pasados desde el servidor
    const usuariosData = {{{usuarios}}};
    console.log('Usuarios cargados:', usuariosData);

    // Montar componente React
    const root = ReactDOM.createRoot(document.getElementById('admin-usuarios-root'));
    root.render(React.createElement(AdminUsuarios, { usuarios: usuariosData }));
</script>


        </div>
    </div>
</div>


