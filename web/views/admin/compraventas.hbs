{{!-- Panel admin: lista de todas las compraventas del sistema (solo accesible con rol admin). --}}

<div class="container-fluid mt-5 mb-5">
    <div class="row">
        <div class="col-12">
            <h1 class="fw-bold mb-4">
                <i class="fa-solid fa-handshake me-2 text-success"></i>Gestión de Compraventas
            </h1>
        </div>
    </div>

    <div id="admin-compraventas-root"></div>
</div>

<style>
    .admin-compraventas {
        padding: 1rem;
    }

    .filters-container {
        background: white;
        padding: 1.5rem;
        border-radius: 0.375rem;
        border: 1px solid #dee2e6;
        margin-bottom: 1.5rem;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        margin-bottom: 1rem;
    }

    .search-box input {
        flex: 1;
        border: none;
        background: transparent;
        outline: none;
        font-size: 0.95rem;
    }

    .filters-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .filter-group {
        flex: 1;
        min-width: 200px;
    }

    .filter-group label {
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #495057;
    }

    .filter-group input,
    .sort-select select {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        background: white;
        font-size: 0.95rem;
    }

    .sort-select {
        flex: 1;
        min-width: 200px;
    }

    .info-count {
        padding: 0.75rem 0;
        margin-bottom: 1rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .table-responsive {
        margin-bottom: 0;
    }

    .table {
        margin-bottom: 0;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .mono {
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        color: #6c757d;
    }

    .producto-name {
        font-weight: 600;
    }

    .date {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .empty-state p {
        margin: 1rem 0 0 0;
    }
</style>

<script>
    // Componente React para listar compraventas
    const { useState, useMemo } = React;

    function AdminCompraventas({ compraventas: compraventasInicial = [] }) {
        const [busqueda, setBusqueda] = useState('');
        const [ordenar, setOrdenar] = useState('fecha');
        const [filtroComprador, setFiltroComprador] = useState('');
        const [filtroVendedor, setFiltroVendedor] = useState('');

        // Filtrar
        const compraventasFiltradas = useMemo(() => {
            return compraventasInicial.filter(c => {
                const coincidenBusqueda = !busqueda || 
                    (c.IDPRODUCTO && c.IDPRODUCTO.toString().includes(busqueda)) ||
                    (c.NOMBREPRODUCTO && c.NOMBREPRODUCTO.toLowerCase().includes(busqueda.toLowerCase())) ||
                    (c.NOMBRE_COMPRADOR && c.NOMBRE_COMPRADOR.toLowerCase().includes(busqueda.toLowerCase())) ||
                    (c.NOMBRE_VENDEDOR && c.NOMBRE_VENDEDOR.toLowerCase().includes(busqueda.toLowerCase()));
                
                const coincidenComprador = !filtroComprador || (c.IDCOMPRADOR && c.IDCOMPRADOR.toString() === filtroComprador);
                const coincidenVendedor = !filtroVendedor || (c.IDVENDEDOR && c.IDVENDEDOR.toString() === filtroVendedor);
                
                return coincidenBusqueda && coincidenComprador && coincidenVendedor;
            });
        }, [busqueda, filtroComprador, filtroVendedor, compraventasInicial]);

        // Ordenar
        const compraventasOrdenadas = useMemo(() => {
            const copia = [...compraventasFiltradas];
            if (ordenar === 'fecha') {
                copia.sort((a, b) => new Date(b.FECHACOMPRA || 0) - new Date(a.FECHACOMPRA || 0));
            } else if (ordenar === 'precio') {
                copia.sort((a, b) => (b.PRECIO || 0) - (a.PRECIO || 0));
            } else if (ordenar === 'producto') {
                copia.sort((a, b) => (a.NOMBREPRODUCTO || '').localeCompare(b.NOMBREPRODUCTO || ''));
            }
            return copia;
        }, [compraventasFiltradas, ordenar]);

        return React.createElement('div', { className: 'admin-compraventas' },
            React.createElement('div', { className: 'filters-container' },
                React.createElement('div', { className: 'search-box' },
                    React.createElement('i', { className: 'fa-solid fa-search' }),
                    React.createElement('input', {
                        type: 'text',
                        placeholder: 'Buscar por producto, comprador o vendedor...',
                        value: busqueda,
                        onChange: (e) => setBusqueda(e.target.value)
                    })
                ),
                React.createElement('div', { className: 'filters-row' },
                    React.createElement('div', { className: 'filter-group' },
                        React.createElement('label', null, 'Comprador:'),
                        React.createElement('input', {
                            type: 'text',
                            placeholder: 'ID comprador...',
                            value: filtroComprador,
                            onChange: (e) => setFiltroComprador(e.target.value)
                        })
                    ),
                    React.createElement('div', { className: 'filter-group' },
                        React.createElement('label', null, 'Vendedor:'),
                        React.createElement('input', {
                            type: 'text',
                            placeholder: 'ID vendedor...',
                            value: filtroVendedor,
                            onChange: (e) => setFiltroVendedor(e.target.value)
                        })
                    ),
                    React.createElement('div', { className: 'sort-select' },
                        React.createElement('select', {
                            value: ordenar,
                            onChange: (e) => setOrdenar(e.target.value)
                        },
                            React.createElement('option', { value: 'fecha' }, 'Ordenar por: Fecha (reciente)'),
                            React.createElement('option', { value: 'precio' }, 'Ordenar por: Precio (mayor)'),
                            React.createElement('option', { value: 'producto' }, 'Ordenar por: Producto')
                        )
                    )
                )
            ),
            React.createElement('div', { className: 'info-count' },
                React.createElement('span', null, compraventasOrdenadas.length + ' transacciones encontradas')
            ),
            compraventasOrdenadas.length > 0 ? React.createElement('div', { className: 'table-responsive' },
                React.createElement('table', { className: 'table table-hover' },
                    React.createElement('thead', { className: 'table-light' },
                        React.createElement('tr', null,
                            React.createElement('th', null, 'ID'),
                            React.createElement('th', null, 'Producto'),
                            React.createElement('th', null, 'Comprador'),
                            React.createElement('th', null, 'Vendedor'),
                            React.createElement('th', { className: 'text-center' }, 'Precio'),
                            React.createElement('th', null, 'Fecha')
                        )
                    ),
                    React.createElement('tbody', null,
                        compraventasOrdenadas.map((compra) =>
                            React.createElement('tr', { key: compra.ID },
                                React.createElement('td', { className: 'mono' }, compra.ID),
                                React.createElement('td', null,
                                    React.createElement('span', { className: 'producto-name' }, compra.NOMBREPRODUCTO),
                                    React.createElement('br'),
                                    React.createElement('small', { className: 'text-muted' }, 'ID: ' + compra.IDPRODUCTO)
                                ),
                                React.createElement('td', null,
                                    React.createElement('span', null, compra.NOMBRE_COMPRADOR),
                                    React.createElement('br'),
                                    React.createElement('small', { className: 'text-muted' }, 'ID: ' + compra.IDCOMPRADOR)
                                ),
                                React.createElement('td', null,
                                    React.createElement('span', null, compra.NOMBRE_VENDEDOR),
                                    React.createElement('br'),
                                    React.createElement('small', { className: 'text-muted' }, 'ID: ' + compra.IDVENDEDOR)
                                ),
                                React.createElement('td', { className: 'text-center' },
                                    React.createElement('span', { className: 'badge bg-success' }, '$' + (compra.PRECIO || '0.00').toFixed(2))
                                ),
                                React.createElement('td', { className: 'date' },
                                    new Date(compra.FECHACOMPRA).toLocaleDateString('es-ES', {
                                        year: 'numeric',
                                        month: 'short',
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    })
                                )
                            )
                        )
                    )
                )
            ) : React.createElement('div', { className: 'empty-state' },
                React.createElement('i', { className: 'fa-solid fa-inbox' }),
                React.createElement('p', null, 'No hay transacciones que coincidan con los filtros')
            )
        );
    }

    // Datos pasados desde el servidor
    const compraventasData = {{{compraventas}}};
    console.log('Compraventas cargadas:', compraventasData);

    // Montar componente React
    const root = ReactDOM.createRoot(document.getElementById('admin-compraventas-root'));
    root.render(React.createElement(AdminCompraventas, { compraventas: compraventasData }));
</script>


