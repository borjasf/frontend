{{!-- Vista de solo lectura de un producto. Sin botones de acción. --}}
<div class="container mt-5 mb-5">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/perfil/mis-compras" class="text-decoration-none">Mis compras</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{producto.nombreCategoria}}</li>
        </ol>
    </nav>

    <article class="card shadow-sm border-0 mt-3 overflow-hidden">
        <div class="row g-0">

            <figure class="col-md-6 bg-light m-0 d-flex align-items-center justify-content-center">
                <img src="{{#if producto.rutaImagen}}{{producto.rutaImagen}}{{else}}/img/fotografia_producto_sin_foto.jpg{{/if}}" class="img-fluid object-fit-cover detalle-imagen" alt="Fotografía de {{producto.titulo}}">
            </figure>

            <section class="col-md-6 p-4 p-lg-5 d-flex flex-column">

                <header class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted"><i class="fa-regular fa-eye me-1"></i>{{producto.visualizaciones}} visitas</small>
                    </div>
                    <h1 class="fw-bold h2 mb-1">{{producto.titulo}}</h1>
                    <p class="text-muted small mb-3">Publicado el {{producto.fechaPublicacion}}</p>
                    <h2 class="text-success fw-bold h1">{{producto.precio}} €</h2>
                </header>

                <div class="mb-4">
                    <h3 class="h5 fw-bold border-bottom pb-2">Descripción</h3>
                    <p class="text-muted mt-2" style="white-space: pre-line;">{{producto.descripcion}}</p>
                </div>

                <aside class="bg-light p-3 rounded mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-user-circle fs-3 text-secondary me-3"></i>
                        <div>
                            <p class="mb-0 small text-muted">Publicado por</p>
                            <p class="mb-0 fw-bold">{{producto.nombreVendedor}}</p>
                        </div>
                    </div>
                    <div class="text-secondary small mb-2">
                        <i class="fa-solid fa-location-dot me-2"></i><strong>{{producto.lugarRecogida.descripcion}}</strong><br>
                        <span style="margin-left: 20px; display: block; font-size: 0.8rem; color: #6c757d;">
                            Lat: {{producto.lugarRecogida.latitud}}, Lon: {{producto.lugarRecogida.longitud}}
                        </span>
                    </div>
                    {{#if producto.envioDisponible}}
                    <div class="text-success small">
                        <i class="fa-solid fa-truck-fast me-2"></i>Envío a domicilio disponible
                    </div>
                    {{else}}
                    <div class="text-secondary small">
                        <i class="fa-solid fa-people-carry-box me-2"></i>Solo entrega en mano
                    </div>
                    {{/if}}
                </aside>

                <div class="mt-auto">
                    <a href="/perfil/mis-compras" class="btn btn-outline-secondary w-100 py-2">
                        <i class="fa-solid fa-arrow-left me-2"></i>Volver a mis compras
                    </a>
                </div>

            </section>
        </div>
    </article>
</div>
