{{!-- Formulario para publicar un nuevo producto (requiere estar autenticado).
      Campos: título, descripción, precio, estado (nuevo/como nuevo/buen estado/aceptable), categoría (select cargado desde API), envío disponible.
      Hace POST /productos. El idVendedor se toma del usuario en sesión en el servidor. --}}
{{!--Se va a utilizar el mapa de Leaflet para poder seleccionar la ubicación del producto --}}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
      .input-group .form-control.is-invalid {
          background-image: none;
          padding-right: 0.75rem;
      }
  </style>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0 text-center">Publicar en Segundum</h4>
                </div>
                <div class="card-body p-4">
                    <form action="/productos/crear" method="POST" novalidate enctype="multipart/form-data">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">¿Qué vendes?</label>
                            <input type="text" class="form-control" name="titulo" required placeholder="Ej: PlayStation 5 impecable">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Foto del producto</label>
                            <input type="file" class="form-control" name="imagen" accept="image/*" placeholder="Sube una foto (JPG, PNG, GIF, WebP - máximo 5MB)">
                            <small class="text-muted">Opcional. Si no subes foto, se usará una por defecto.</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Precio</label>
                                <div class="input-group">
                                    <input type="number" step="0.01" min="0.01" class="form-control" name="precio" required>
                                    <span class="input-group-text">€</span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Categoría</label>
                                <select class="form-select" name="categoria" required>
                                    <option value="" disabled selected>Cargando categorías...</option>
                                    {{#each categorias}}
                                        <option value="{{this.id}}">{{this.nombre}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Estado del producto</label>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="estado" id="nuevo" value="NUEVO" checked>
                                    <label class="form-check-label" for="nuevo">Nuevo</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="estado" id="comoNuevo" value="COMO_NUEVO">
                                    <label class="form-check-label" for="comoNuevo">Como nuevo</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="estado" id="bueno" value="BUEN_ESTADO">
                                    <label class="form-check-label" for="bueno">Buen estado</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="estado" id="aceptable" value="ACEPTABLE">
                                    <label class="form-check-label" for="aceptable">Aceptable</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="estado" id="paraReparar" value="PARA_REPARAR">
                                    <label class="form-check-label" for="paraReparar">Para reparar</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Descripción</label>
                            <textarea class="form-control" name="descripcion" rows="3" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Lugar de recogida</label>
                            <input type="text" class="form-control" name="lugarRecogida" required placeholder="Ej: Centro comercial, domicilio, etc.">
                        </div>
                        {{!-- Ponemos un mapa para que el usuario pueda seleccionar la ubicacion del producto de forma visual --}}
                        <div class="mb-3">
                            <label class="form-label fw-bold">Selecciona la ubicación en el mapa</label>
                            <p class="text-muted small mb-2">Haz clic en el mapa para marcar dónde se realizará la entrega.</p>
                            <div id="mapa-seleccion" class="rounded" style="height: 300px; z-index: 0;"></div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Latitud</label>
                                <input type="number" step="0.0001" class="form-control" name="latitud" id="inputLatitud" value="" readonly >
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Longitud</label>
                                <input type="number" step="0.0001" class="form-control" name="longitud" id="inputLongitud" value="" readonly >
                            </div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" id="envio" name="envioDisponible">
                            <label class="form-check-label" for="envio">Ofrezco envío a domicilio</label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg">Publicar anuncio</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

<script src="/js/validaciones.js"></script>
<script>
      document.addEventListener('DOMContentLoaded', () => {
          // Centro inicial: Murcia
          const centroInicial = [37.9922, -1.1307];

          const mapa = L.map('mapa-seleccion').setView(centroInicial, 13);

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '© OpenStreetMap',
              maxZoom: 19
          }).addTo(mapa);

          let marker = null;
          
          //Bloqueamos el subit si no se ha seleccionado una ubicación (latitud y longitud deben tener un valor distinto de 0)
          const formulario = document.querySelector('form[action="/productos/crear"]');
          const inputLatitud = document.getElementById('inputLatitud');
          const inputLongitud = document.getElementById('inputLongitud');
          const divMapa = document.getElementById('mapa-seleccion');

          formulario.addEventListener('submit', (e) => {
                // Validación general de campos
                let esValido = validaciones.validarFormularioCrearProducto(formulario);

                // Validación específica de ubicación (lat/lng) con mensaje visual sobre el mapa
                if (!inputLatitud.value || !inputLongitud.value) {
                    divMapa.style.border = '2px solid #dc3545';
                    let errorMsg = document.getElementById('errorUbicacion');
                    if (!errorMsg) {
                        errorMsg = document.createElement('div');
                        errorMsg.id = 'errorUbicacion';
                        errorMsg.className = 'alert alert-danger mt-2 mb-0 py-2';
                        errorMsg.innerHTML = '<i class="fa-solid fa-circle-exclamation me-2"></i>Debes seleccionar una ubicación haciendo clic en el mapa.';
                        divMapa.parentNode.appendChild(errorMsg);
                    }
                    esValido = false;
                }

                if (!esValido) {
                    e.preventDefault();
                    // Hacer scroll al primer error (input con is-invalid, o si no, al mapa)
                    const primerError = formulario.querySelector('.is-invalid') || divMapa;
                    primerError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });

          // Al hacer clic, colocar/mover marker y actualizar inputs
          mapa.on('click', (e) => {
              const { lat, lng } = e.latlng;

              if (marker) {
                  marker.setLatLng([lat, lng]);
              } else {
                  marker = L.marker([lat, lng], { draggable: true }).addTo(mapa);
                  // Si arrastra el marker, actualizar inputs también
                  marker.on('dragend', (ev) => {
                      const pos = ev.target.getLatLng();
                      document.getElementById('inputLatitud').value = pos.lat.toFixed(6);
                      document.getElementById('inputLongitud').value = pos.lng.toFixed(6);
                  });
              }

              document.getElementById('inputLatitud').value = lat.toFixed(6);
              document.getElementById('inputLongitud').value = lng.toFixed(6);

              //Cuando el usuario selecciona una ubicacion, se quita el error que habia si no habia seleccionado una
              // Quitar el error visual si lo había
              divMapa.style.border = '';
              const errorPrevio = document.getElementById('errorUbicacion');
              if (errorPrevio) errorPrevio.remove();
          });

          // Limpieza automática de marcas rojas al escribir en los inputs
          validaciones.inicializarLimpiezaErrores(formulario);
      });
  </script>
</div>